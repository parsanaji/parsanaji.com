{
  "name": "parsanaji.com",
  "private": true,
  "version": "0.1.0",
  "description": "Personal site of Parsa Naji: a one-screen résumé over a WebGL2 field of flowing dashes.",
  "homepage": "https://parsanaji.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parsanaji/parsanaji.com.git"
  },
  "author": "Parsa Naji",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fonts": "node scripts/subset-fonts.mjs",
    "og": "node scripts/og-image.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name parsanaji-com --branch main --commit-dirty=true",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name parsanaji-com --branch preview --commit-dirty=true"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.20.5",
    "fontverter": "2.0.0",
    "harfbuzzjs": "1.6.3",
    "lil-gui": "0.21.0",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.0"
  }
}
